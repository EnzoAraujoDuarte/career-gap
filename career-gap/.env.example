# Copie para .env.local e preencha. Sem DATABASE_URL, o Career Gap funciona inteiro no navegador.

# Postgres (Neon): a string de conexão "pooled" do painel do projeto.
DATABASE_URL=

# Segredo que assina as sessões. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Endereço do site. Em desenvolvimento: http://localhost:3000
BETTER_AUTH_URL=

# Opcional — login com Google. Retorno a cadastrar: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional — login com GitHub. Retorno a cadastrar: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
